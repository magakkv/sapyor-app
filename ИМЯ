.top { display: flex; align-items: center; gap: 12px; margin: 4px 0 10px; }
.top h1 { margin: 0; }
.ov { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: none; align-items: center;
  justify-content: center; padding: 16px; z-index: 10; }
.ov.show { display: flex; }
.card { background: var(--bg); color: var(--text); border-radius: 18px; padding: 18px; width: 100%;
  max-width: 340px; box-shadow: 0 8px 30px rgba(0,0,0,.35); }
.who { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
.ava { width: 52px; height: 52px; border-radius: 50%; background: var(--accent); color: var(--accent-text);
  display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 800; }
.nm { font-size: 18px; font-weight: 800; }
.rk { color: var(--hint); font-size: 14px; }
.row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 15px;
  border-bottom: 1px solid rgba(128,128,128,.2); }
.bar { height: 8px; border-radius: 4px; background: var(--bg2); overflow: hidden; margin: 8px 0 4px; }
.bar i { display: block; height: 100%; background: var(--accent); }
.note { color: var(--hint); font-size: 12px; margin: 8px 0 14px; }
.card .primary { width: 100%; }
